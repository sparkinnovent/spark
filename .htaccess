# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
#
# FIX - session.save_path was pinned to /var/cpanel/php/sessions/ea-php73.
# This application requires PHP 8.0+, so on any PHP 8 host that directory does
# not exist. session_start() then failed silently, $_SESSION stayed empty, and
# the installer's "Install now" button did nothing at all - it posted, the
# session lookup came back empty, and the same page rendered again with no
# error. The directive is removed rather than repointed: PHP's compiled-in
# default already matches the running version, which is what we want.
<IfModule php7_module>
   php_flag display_errors Off
   php_value max_execution_time 650
   php_value max_input_time 650
   php_value max_input_vars 3000
   php_value memory_limit 256M
   php_value post_max_size 256M
   php_value session.gc_maxlifetime 1440
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression On
</IfModule>
<IfModule lsapi_module>
   php_flag display_errors Off
   php_value max_execution_time 650
   php_value max_input_time 650
   php_value max_input_vars 3000
   php_value memory_limit 256M
   php_value post_max_size 256M
   php_value session.gc_maxlifetime 1440
   php_value upload_max_filesize 128M
   php_flag zlib.output_compression On
</IfModule>
# END cPanel-generated php ini directives, do not edit
Options -Indexes

# ---------------------------------------------------------------------------
# FIX L1 / L2 / L3 - files that must never be served
# ---------------------------------------------------------------------------

# L1: the PHP error log sat in the web root and Apache served it as text. It
# leaked absolute paths, the session save path and full SQL errors.
<FilesMatch "^(error_log|php_errors?\.log|.*\.log)$">
    Require all denied
</FilesMatch>

# L2: backup, archive and pre-fix copies of the application. Several were
# complete old portals with their own unpatched handlers.
<FilesMatch "\.(bak|old|orig|save|swp|swo|zip|tar|gz|tgz|rar|7z|sql|ini|log)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(php|inc)~$">
    Require all denied
</FilesMatch>

# The cPanel-generated php.ini backups and the .htaccess copies.
<FilesMatch "^(\.htaccess-.*|\.user-.*|php.*\.ini.*|htaccess\.zip)$">
    Require all denied
</FilesMatch>

# L3: the installer writes config.php and can re-create the admin account, so
# it must not be reachable once the site is live.
#
# FIX - this rule was an unconditional "RewriteRule ^install/ - [F,L]", which
# blocked the installer on a fresh deployment too. Nobody could ever install.
# The installer is only dangerous while config.php does not exist, so the block
# is conditional on exactly that. install/.htaccess carries the same rule for
# hosts where this file is lost or merged differently.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{DOCUMENT_ROOT}/config.php -f
    RewriteRule ^install/ - [F,L]
</IfModule>

# L2 - the retired-file archive must never be served.
<IfModule mod_rewrite.c>
    RewriteRule ^_retired/ - [F,L]
</IfModule>

# config.php holds the database and SMTP credentials. Apache executes .php
# rather than serving it, so this was not a leak - but a handler misconfiguration
# could expose it, and nothing legitimate requests it by URL.
<FilesMatch "^config(\.sample)?\.php$">
    Require all denied
</FilesMatch>